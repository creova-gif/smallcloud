# SmallCloud Environment Configuration Template
# Copy this file to `.env` and replace placeholder values before running in production.
# Never commit real secrets or credentials.

# ------------------------------------------------------------------------------
# Core Daemon & CLI Connection
# ------------------------------------------------------------------------------

# Directory where the SmallCloud daemon stores state, cgroup metadata, and replicas.
SMALLCLOUD_STATE_DIR=./smallcloud-state

# Base URL of a running `smallcloud serve` daemon. When set, CLI commands communicate
# with the daemon over HTTP instead of reading/writing local state files directly.
SMALLCLOUD_DAEMON_URL=http://127.0.0.1:7420

# Bearer token required on `/v1/*` daemon HTTP endpoints (`/healthz` and `/readyz` remain open).
# Also attached automatically by the CLI when `SMALLCLOUD_DAEMON_URL` is set.
# Generate a strong random secret (e.g., `openssl rand -hex 32`).
SMALLCLOUD_API_TOKEN=replace-with-random-bearer-token

# ------------------------------------------------------------------------------
# Runtime & Reverse Proxy
# ------------------------------------------------------------------------------

# Container/process runtime backend for deployments (set to `docker` for DockerRuntime;
# leave empty for the default in-process/simulated runtime).
SMALLCLOUD_RUNTIME=docker

# Caddy Admin API URL used when syncing live Blue/Green routes.
SMALLCLOUD_CADDY_ADMIN_URL=http://127.0.0.1:2019

# Timeout duration for HTTP readiness probes against deployed containers.
SMALLCLOUD_HEALTH_PROBE_TIMEOUT=2s

# ------------------------------------------------------------------------------
# Background Loops & Maintenance
# ------------------------------------------------------------------------------

# Interval for automated monthly billing-cycle rollover checks.
SMALLCLOUD_ROLLOVER_INTERVAL=1h

# Time-to-live for stale worker nodes before the daemon reaps them.
SMALLCLOUD_WORKER_TTL=5m

# ------------------------------------------------------------------------------
# HTTP Security, Rate Limiting & Logging
# ------------------------------------------------------------------------------

# Maximum HTTP API requests per minute allowed per client IP by RateLimitMiddleware.
SMALLCLOUD_RATE_LIMIT=600

# Comma-separated trusted proxy IPs or CIDRs allowed to supply `X-Forwarded-For`
# or `X-Real-IP` headers for rate-limit client IP resolution.
SMALLCLOUD_TRUSTED_PROXIES=127.0.0.1/32

# Enable structured JSON HTTP access logging to stderr (`true` or `false`).
SMALLCLOUD_ACCESS_LOG=true

# ------------------------------------------------------------------------------
# Webhooks (Outbound Alerts & Inbound GitOps)
# ------------------------------------------------------------------------------

# Target HTTP(S) endpoint for signed outbound budget and alert webhook deliveries.
SMALLCLOUD_WEBHOOK_URL=https://hooks.example.com/smallcloud/alerts

# HMAC-SHA256 signing secret used for `X-SmallCloud-Signature-256` on outbound webhooks.
SMALLCLOUD_WEBHOOK_SECRET=replace-with-outbound-webhook-secret

# HMAC-SHA256 secret used to verify `X-Hub-Signature-256` on inbound GitHub push webhooks.
SMALLCLOUD_GITHUB_WEBHOOK_SECRET=replace-with-github-webhook-secret
